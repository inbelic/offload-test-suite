#--- vertex.hlsl
struct VSOutput {
  float4 Pos : SV_Position;
  half S : ATTR0;
  half2 V2 : ATTR1;
  half3 V3 : ATTR2;
  half4 V4 : ATTR3;
};

VSOutput main(float2 Position : POSITION) {
  // Pixel coordinate of this vertex in the 1x1 render target.
  float2 P = float2(Position.x + 1, 1 - Position.y) / 2;
  VSOutput O;
  O.Pos = float4(Position, 0, 1);
  O.S = (half)P.x;
  O.V2 = (half2)P;
  O.V3 = (half3)P.xyx;
  O.V4 = (half4)P.xyxy;
  return O;
}

#--- pixel.hlsl
struct PSInput {
  float4 Pos : SV_Position;
  uint SampleIndex : SV_SampleIndex;
  half S : ATTR0;
  half2 V2 : ATTR1;
  half3 V3 : ATTR2;
  half4 V4 : ATTR3;
};

// Widened to float (exact) so the buffer stays 32-bit.
RWStructuredBuffer<float4> Out : register(u0);

float4 main(PSInput I) : SV_Target {
  float2 Q = I.Pos.xy;
  uint Base = I.SampleIndex * 4;
  Out[Base + 0] = float4(EvaluateAttributeAtSample(I.S, I.SampleIndex) - Q.x, 0, 0, 0);
  Out[Base + 1] = float4(EvaluateAttributeAtSample(I.V2, I.SampleIndex) - Q, 0, 0);
  Out[Base + 2] = float4(EvaluateAttributeAtSample(I.V3, I.SampleIndex) - Q.xyx, 0);
  Out[Base + 3] = EvaluateAttributeAtSample(I.V4, I.SampleIndex) - Q.xyxy;
  return 0;
}

#--- pipeline.yaml
---
Shaders:
  - Stage: Vertex
    Entry: main
  - Stage: Pixel
    Entry: main
Buffers:
  - Name: VertexData
    Format: Float32
    Stride: 8
    Data: [-1, -1, 3, -1, -1, 3]
  - Name: RenderTarget
    Format: Float32
    Channels: 4
    FillSize: 16
    OutputProps:
      Height: 1
      Width: 1
      Depth: 1
  - Name: Out
    Format: Float32
    Stride: 16
    FillSize: 256
    FillValue: 100 # Any value the shader does not write fails.
  - Name: ExpectedOut
    Format: Float32
    Stride: 16
    FillSize: 256
Bindings:
  VertexBuffer: VertexData
  VertexAttributes:
    - Format: Float32
      Channels: 2
      Offset: 0
      Name: POSITION
  RenderTarget: RenderTarget
  SampleCount: 4
DescriptorSets:
  - Resources:
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
Results:
  - Result: Evaluate
    Rule: BufferFloatEpsilon
    Epsilon: 0.001
    Actual: Out
    Expected: ExpectedOut
...
#--- end

# SV_SampleIndex makes the shader run per sample, with SV_Position at the
# sample. Sample locations are not portable, so each sample writes the
# evaluated attribute minus SV_Position, which must be 0.

# Unimplemented https://github.com/llvm/llvm-project/issues/99109
# XFAIL: Clang

# DXC's SPIR-V backend emits InterpolateAt* on 16-bit floats, which is
# invalid SPIR-V.
# XFAIL: DXC && Vulkan

# REQUIRES: Half && (!Vulkan || (VulkanSampleRateShading && VulkanStorageInputOutput16))

# RUN: split-file %s %t
# RUN: %dxc_target -T vs_6_2 -enable-16bit-types -Fo %t-vertex.o %t/vertex.hlsl
# RUN: %dxc_target -T ps_6_2 -enable-16bit-types -Fo %t-pixel.o %t/pixel.hlsl
# RUN: %offloader %t/pipeline.yaml %t-vertex.o %t-pixel.o
