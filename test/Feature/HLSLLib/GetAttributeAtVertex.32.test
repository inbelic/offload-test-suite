#--- common.hlsl
// The value each vertex writes, by SV_VertexID.
int4 VI(uint V) {
  return int4(-7, 13, 0x7FFFFFF0, -0x7FFFFFF0) + (int)V * int4(5, -11, 3, -3);
}
uint4 VU(uint V) {
  return uint4(0xFFFFFFF0, 1, 0x80000000, 42) + V * uint4(1, 2, 3, 4);
}

#--- vertex.hlsl
#include "common.hlsl"

struct VSOutput {
  float4 Pos : SV_Position;
  nointerpolation int I1 : ATTR0;
  nointerpolation int2 I2 : ATTR1;
  nointerpolation int3 I3 : ATTR2;
  nointerpolation int4 I4 : ATTR3;
  nointerpolation uint U1 : ATTR4;
  nointerpolation uint2 U2 : ATTR5;
  nointerpolation uint3 U3 : ATTR6;
  nointerpolation uint4 U4 : ATTR7;
};

VSOutput main(float2 Position : POSITION, uint VertexID : SV_VertexID) {
  VSOutput O;
  O.Pos = float4(Position, 0, 1);
  O.I1 = VI(VertexID).x;
  O.I2 = VI(VertexID).xy;
  O.I3 = VI(VertexID).xyz;
  O.I4 = VI(VertexID);
  O.U1 = VU(VertexID).x;
  O.U2 = VU(VertexID).xy;
  O.U3 = VU(VertexID).xyz;
  O.U4 = VU(VertexID);
  return O;
}

#--- pixel.hlsl
#include "common.hlsl"

struct PSInput {
  float4 Pos : SV_Position;
  nointerpolation int I1 : ATTR0;
  nointerpolation int2 I2 : ATTR1;
  nointerpolation int3 I3 : ATTR2;
  nointerpolation int4 I4 : ATTR3;
  nointerpolation uint U1 : ATTR4;
  nointerpolation uint2 U2 : ATTR5;
  nointerpolation uint3 U3 : ATTR6;
  nointerpolation uint4 U4 : ATTR7;
};

#define CHECK_VERTEX(V)                                                        \
  Pass = Pass && all(GetAttributeAtVertex(I.I1, V) == VI(V).x);                \
  Pass = Pass && all(GetAttributeAtVertex(I.I2, V) == VI(V).xy);               \
  Pass = Pass && all(GetAttributeAtVertex(I.I3, V) == VI(V).xyz);              \
  Pass = Pass && all(GetAttributeAtVertex(I.I4, V) == VI(V));                  \
  Pass = Pass && all(GetAttributeAtVertex(I.U1, V) == VU(V).x);                \
  Pass = Pass && all(GetAttributeAtVertex(I.U2, V) == VU(V).xy);               \
  Pass = Pass && all(GetAttributeAtVertex(I.U3, V) == VU(V).xyz);              \
  Pass = Pass && all(GetAttributeAtVertex(I.U4, V) == VU(V));

float4 main(PSInput I) : SV_Target {
  bool Pass = true;
  CHECK_VERTEX(0)
  CHECK_VERTEX(1)
  CHECK_VERTEX(2)

  // Plain reads return the provoking vertex, vertex 0.
  Pass = Pass && all(I.I1 == VI(0).x);
  Pass = Pass && all(I.I2 == VI(0).xy);
  Pass = Pass && all(I.I3 == VI(0).xyz);
  Pass = Pass && all(I.I4 == VI(0));
  Pass = Pass && all(I.U1 == VU(0).x);
  Pass = Pass && all(I.U2 == VU(0).xy);
  Pass = Pass && all(I.U3 == VU(0).xyz);
  Pass = Pass && all(I.U4 == VU(0));
  return (float4)Pass;
}

#--- pipeline.yaml
---
Shaders:
  - Stage: Vertex
    Entry: main
  - Stage: Pixel
    Entry: main
Buffers:
  # One triangle that covers the whole render target.
  - Name: VertexData
    Format: Float32
    Stride: 8
    Data: [-1, -1, 3, -1, -1, 3]
  - Name: Output
    Format: Float32
    Channels: 4
    FillSize: 256
    OutputProps:
      Height: 4
      Width: 4
      Depth: 1
  - Name: ExpectedOut
    Format: Float32
    Channels: 4
    FillSize: 256
    FillValue: 1
Bindings:
  VertexBuffer: VertexData
  VertexAttributes:
    - Format: Float32
      Channels: 2
      Offset: 0
      Name: POSITION
  RenderTarget: Output
DescriptorSets: []
Results:
  - Result: AttributeAtVertex
    Rule: BufferExact
    Actual: Output
    Expected: ExpectedOut
...
#--- end

# GetAttributeAtVertex(Attr, Index) returns the uninterpolated value of a
# nointerpolation attribute at vertex Index of the triangle, in the order the
# vertices were submitted (the same order SV_Barycentrics uses). A single
# triangle covers the 4x4 render target and the vertex shader writes a
# different value per SV_VertexID, so each pixel can check all three vertices.
# A plain read of a nointerpolation attribute returns the provoking vertex,
# which is vertex 0 by default on both DirectX and Vulkan. The plain reads
# also keep the attributes marked as used in the DXIL input signature
# (https://github.com/microsoft/DirectXShaderCompiler/issues/5417).

# Unimplemented https://github.com/llvm/llvm-project/issues/99201
# XFAIL: Clang

# REQUIRES: SM_6_1 && Barycentrics

# RUN: split-file %s %t
# RUN: %dxc_target -T vs_6_0 -Fo %t-vertex.o %t/vertex.hlsl
# RUN: %dxc_target -T ps_6_1 -Fo %t-pixel.o %t/pixel.hlsl
# RUN: %offloader %t/pipeline.yaml %t-vertex.o %t-pixel.o
