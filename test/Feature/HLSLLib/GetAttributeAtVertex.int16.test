#--- vertex.hlsl
struct VSOutput {
  float4 Pos : SV_Position;
  nointerpolation int16_t A : ATTR0;
  nointerpolation uint16_t2 B : ATTR1;
  nointerpolation int16_t3 C : ATTR2;
  nointerpolation uint16_t4 D : ATTR3;
};

VSOutput main(float2 Position : POSITION, uint VertexID : SV_VertexID) {
  uint V = VertexID + 1;
  VSOutput O;
  O.Pos = float4(Position, 0, 1);
  O.A = (int16_t)(-1000 * (int)V);
  O.B = (uint16_t2)(uint2(20000, 1) * V);
  O.C = (int16_t3)(int3(-1, 2, -3) * (int)V);
  O.D = (uint16_t4)(uint4(1, 2, 3, 4) * V);
  return O;
}

#--- pixel.hlsl
struct PSInput {
  float4 Pos : SV_Position;
  nointerpolation int16_t A : ATTR0;
  nointerpolation uint16_t2 B : ATTR1;
  nointerpolation int16_t3 C : ATTR2;
  nointerpolation uint16_t4 D : ATTR3;
};

// Widened to 32 bits (exact) so the buffers stay 32-bit.
RWStructuredBuffer<int4> OutI : register(u0);
RWStructuredBuffer<uint4> OutU : register(u1);

float4 main(PSInput I) : SV_Target {
  OutI[0] = int4(GetAttributeAtVertex(I.A, 0), 0, 0, 0);
  OutI[1] = int4(GetAttributeAtVertex(I.A, 1), 0, 0, 0);
  OutI[2] = int4(GetAttributeAtVertex(I.A, 2), 0, 0, 0);

  OutU[0] = uint4(GetAttributeAtVertex(I.B, 0), 0, 0);
  OutU[1] = uint4(GetAttributeAtVertex(I.B, 1), 0, 0);
  OutU[2] = uint4(GetAttributeAtVertex(I.B, 2), 0, 0);

  OutI[3] = int4(GetAttributeAtVertex(I.C, 0), 0);
  OutI[4] = int4(GetAttributeAtVertex(I.C, 1), 0);
  OutI[5] = int4(GetAttributeAtVertex(I.C, 2), 0);

  OutU[3] = (uint4)GetAttributeAtVertex(I.D, 0);
  OutU[4] = (uint4)GetAttributeAtVertex(I.D, 1);
  OutU[5] = (uint4)GetAttributeAtVertex(I.D, 2);
  return 0;
}

#--- pipeline.yaml
---
Shaders:
  - Stage: Vertex
    Entry: main
  - Stage: Pixel
    Entry: main
Buffers:
  - Name: VertexData
    Format: Float32
    Stride: 8
    Data: [-1, -1, 3, -1, -1, 3]
  - Name: RenderTarget
    Format: Float32
    Channels: 4
    FillSize: 16
    OutputProps:
      Height: 1
      Width: 1
      Depth: 1
  - Name: OutI
    Format: Int32
    Stride: 16
    FillSize: 96
    FillValue: 12345 # Any value the shader does not write fails.
  - Name: ExpectedOutI
    Format: Int32
    Stride: 16
    Data: [-1000, 0, 0, 0,
           -2000, 0, 0, 0,
           -3000, 0, 0, 0,
           -1, 2, -3, 0,
           -2, 4, -6, 0,
           -3, 6, -9, 0]
  - Name: OutU
    Format: UInt32
    Stride: 16
    FillSize: 96
    FillValue: 12345 # Any value the shader does not write fails.
  - Name: ExpectedOutU
    Format: UInt32
    Stride: 16
    Data: [20000, 1, 0, 0,
           40000, 2, 0, 0,
           60000, 3, 0, 0,
           1, 2, 3, 4,
           2, 4, 6, 8,
           3, 6, 9, 12]
Bindings:
  VertexBuffer: VertexData
  VertexAttributes:
    - Format: Float32
      Channels: 2
      Offset: 0
      Name: POSITION
  RenderTarget: RenderTarget
DescriptorSets:
  - Resources:
    - Name: OutI
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: OutU
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
Results:
  - Result: OutI
    Rule: BufferExact
    Actual: OutI
    Expected: ExpectedOutI
  - Result: OutU
    Rule: BufferExact
    Actual: OutU
    Expected: ExpectedOutU
...
#--- end

# Unimplemented https://github.com/llvm/llvm-project/issues/99201
# XFAIL: Clang

# REQUIRES: Int16 && Barycentrics && (!Vulkan || VulkanStorageInputOutput16)

# RUN: split-file %s %t
# RUN: %dxc_target -T vs_6_2 -enable-16bit-types -Fo %t-vertex.o %t/vertex.hlsl
# RUN: %dxc_target -T ps_6_2 -enable-16bit-types -Fo %t-pixel.o %t/pixel.hlsl
# RUN: %offloader %t/pipeline.yaml %t-vertex.o %t-pixel.o
