#--- vertex.hlsl
struct VSOutput {
  float4 Pos : SV_Position;
  nointerpolation float A : ATTR0;
  nointerpolation float2 B : ATTR1;
  nointerpolation float3 C : ATTR2;
  nointerpolation float4 D : ATTR3;
};

VSOutput main(float2 Position : POSITION, uint VertexID : SV_VertexID) {
  float V = (float)(VertexID + 1);
  VSOutput O;
  O.Pos = float4(Position, 0, 1);
  O.A = -0.5 * V;
  O.B = float2(1.5, -2.25) * V;
  O.C = float3(0.25, -3, 4.5) * V;
  O.D = float4(-1, 2.5, -0.75, 8) * V;
  return O;
}

#--- pixel.hlsl
struct PSInput {
  float4 Pos : SV_Position;
  nointerpolation float A : ATTR0;
  nointerpolation float2 B : ATTR1;
  nointerpolation float3 C : ATTR2;
  nointerpolation float4 D : ATTR3;
};

RWStructuredBuffer<float4> Out : register(u0);

float4 main(PSInput I) : SV_Target {
  Out[0] = float4(GetAttributeAtVertex(I.A, 0), 0, 0, 0);
  Out[1] = float4(GetAttributeAtVertex(I.A, 1), 0, 0, 0);
  Out[2] = float4(GetAttributeAtVertex(I.A, 2), 0, 0, 0);

  Out[3] = float4(GetAttributeAtVertex(I.B, 0), 0, 0);
  Out[4] = float4(GetAttributeAtVertex(I.B, 1), 0, 0);
  Out[5] = float4(GetAttributeAtVertex(I.B, 2), 0, 0);

  Out[6] = float4(GetAttributeAtVertex(I.C, 0), 0);
  Out[7] = float4(GetAttributeAtVertex(I.C, 1), 0);
  Out[8] = float4(GetAttributeAtVertex(I.C, 2), 0);

  Out[9] = GetAttributeAtVertex(I.D, 0);
  Out[10] = GetAttributeAtVertex(I.D, 1);
  Out[11] = GetAttributeAtVertex(I.D, 2);
  return 0;
}

#--- pipeline.yaml
---
Shaders:
  - Stage: Vertex
    Entry: main
  - Stage: Pixel
    Entry: main
Buffers:
  - Name: VertexData
    Format: Float32
    Stride: 8
    Data: [-1, -1, 3, -1, -1, 3]
  - Name: RenderTarget
    Format: Float32
    Channels: 4
    FillSize: 16
    OutputProps:
      Height: 1
      Width: 1
      Depth: 1
  - Name: Out
    Format: Float32
    Stride: 16
    FillSize: 192
    FillValue: 12345 # Any value the shader does not write fails.
  - Name: ExpectedOut
    Format: Float32
    Stride: 16
    Data: [-0.5, 0, 0, 0,
           -1, 0, 0, 0,
           -1.5, 0, 0, 0,
           1.5, -2.25, 0, 0,
           3, -4.5, 0, 0,
           4.5, -6.75, 0, 0,
           0.25, -3, 4.5, 0,
           0.5, -6, 9, 0,
           0.75, -9, 13.5, 0,
           -1, 2.5, -0.75, 8,
           -2, 5, -1.5, 16,
           -3, 7.5, -2.25, 24]
Bindings:
  VertexBuffer: VertexData
  VertexAttributes:
    - Format: Float32
      Channels: 2
      Offset: 0
      Name: POSITION
  RenderTarget: RenderTarget
DescriptorSets:
  - Resources:
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
Results:
  - Result: Out
    Rule: BufferExact
    Actual: Out
    Expected: ExpectedOut
...
#--- end

# Unimplemented https://github.com/llvm/llvm-project/issues/99201
# XFAIL: Clang

# REQUIRES: SM_6_1 && Barycentrics

# RUN: split-file %s %t
# RUN: %dxc_target -T vs_6_0 -Fo %t-vertex.o %t/vertex.hlsl
# RUN: %dxc_target -T ps_6_1 -Fo %t-pixel.o %t/pixel.hlsl
# RUN: %offloader %t/pipeline.yaml %t-vertex.o %t-pixel.o
