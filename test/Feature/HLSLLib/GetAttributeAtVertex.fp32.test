#--- common.hlsl
// The value each vertex writes, by SV_VertexID.
float4 VF(uint V) {
  return float4(-1.5, 0.25, 1024.5, -3.75) + V * float4(2, -0.5, 8, 0.125);
}

#--- vertex.hlsl
#include "common.hlsl"

struct VSOutput {
  float4 Pos : SV_Position;
  nointerpolation float F1 : ATTR0;
  nointerpolation float2 F2 : ATTR1;
  nointerpolation float3 F3 : ATTR2;
  nointerpolation float4 F4 : ATTR3;
};

VSOutput main(float2 Position : POSITION, uint VertexID : SV_VertexID) {
  VSOutput O;
  O.Pos = float4(Position, 0, 1);
  O.F1 = VF(VertexID).x;
  O.F2 = VF(VertexID).xy;
  O.F3 = VF(VertexID).xyz;
  O.F4 = VF(VertexID);
  return O;
}

#--- pixel.hlsl
#include "common.hlsl"

struct PSInput {
  float4 Pos : SV_Position;
  nointerpolation float F1 : ATTR0;
  nointerpolation float2 F2 : ATTR1;
  nointerpolation float3 F3 : ATTR2;
  nointerpolation float4 F4 : ATTR3;
};

#define CHECK_VERTEX(V)                                                        \
  Pass = Pass && all(GetAttributeAtVertex(I.F1, V) == VF(V).x);                \
  Pass = Pass && all(GetAttributeAtVertex(I.F2, V) == VF(V).xy);               \
  Pass = Pass && all(GetAttributeAtVertex(I.F3, V) == VF(V).xyz);              \
  Pass = Pass && all(GetAttributeAtVertex(I.F4, V) == VF(V));

float4 main(PSInput I) : SV_Target {
  bool Pass = true;
  CHECK_VERTEX(0)
  CHECK_VERTEX(1)
  CHECK_VERTEX(2)

  // Plain reads return the provoking vertex, vertex 0.
  Pass = Pass && all(I.F1 == VF(0).x);
  Pass = Pass && all(I.F2 == VF(0).xy);
  Pass = Pass && all(I.F3 == VF(0).xyz);
  Pass = Pass && all(I.F4 == VF(0));
  return (float4)Pass;
}

#--- pipeline.yaml
---
Shaders:
  - Stage: Vertex
    Entry: main
  - Stage: Pixel
    Entry: main
Buffers:
  # One triangle that covers the whole render target.
  - Name: VertexData
    Format: Float32
    Stride: 8
    Data: [-1, -1, 3, -1, -1, 3]
  - Name: Output
    Format: Float32
    Channels: 4
    FillSize: 256
    OutputProps:
      Height: 4
      Width: 4
      Depth: 1
  - Name: ExpectedOut
    Format: Float32
    Channels: 4
    FillSize: 256
    FillValue: 1
Bindings:
  VertexBuffer: VertexData
  VertexAttributes:
    - Format: Float32
      Channels: 2
      Offset: 0
      Name: POSITION
  RenderTarget: Output
DescriptorSets: []
Results:
  - Result: AttributeAtVertex
    Rule: BufferExact
    Actual: Output
    Expected: ExpectedOut
...
#--- end

# GetAttributeAtVertex(Attr, Index) returns the uninterpolated value of a
# nointerpolation attribute at vertex Index of the triangle, in the order the
# vertices were submitted (the same order SV_Barycentrics uses). A single
# triangle covers the 4x4 render target and the vertex shader writes a
# different value per SV_VertexID, so each pixel can check all three vertices.
# A plain read of a nointerpolation attribute returns the provoking vertex,
# which is vertex 0 by default on both DirectX and Vulkan. The plain reads
# also keep the attributes marked as used in the DXIL input signature
# (https://github.com/microsoft/DirectXShaderCompiler/issues/5417).

# Unimplemented https://github.com/llvm/llvm-project/issues/99201
# XFAIL: Clang

# REQUIRES: SM_6_1 && Barycentrics

# RUN: split-file %s %t
# RUN: %dxc_target -T vs_6_0 -Fo %t-vertex.o %t/vertex.hlsl
# RUN: %dxc_target -T ps_6_1 -Fo %t-pixel.o %t/pixel.hlsl
# RUN: %offloader %t/pipeline.yaml %t-vertex.o %t-pixel.o
