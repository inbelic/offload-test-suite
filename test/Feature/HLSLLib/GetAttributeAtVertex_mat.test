#--- common.hlsl
// The value each vertex writes to element [R][C], by SV_VertexID.
float FM(uint V, uint R, uint C) { return 10.0 * V + 4 * R + C - 7.5; }

#--- vertex.hlsl
#include "common.hlsl"

struct VSOutput {
  float4 Pos : SV_Position;
  nointerpolation float3x2 M32 : MATA;
  nointerpolation float2x4 M24 : MATB;
  nointerpolation float3x1 M31 : MATC;
  nointerpolation float4x4 M44 : MATD;
};

#define FILL(M, Rows, Cols)                                                    \
  [unroll] for (uint R = 0; R < Rows; ++R)                                     \
    [unroll] for (uint C = 0; C < Cols; ++C)                                   \
      M[R][C] = FM(VertexID, R, C);

VSOutput main(float2 Position : POSITION, uint VertexID : SV_VertexID) {
  VSOutput O;
  O.Pos = float4(Position, 0, 1);
  FILL(O.M32, 3, 2)
  FILL(O.M24, 2, 4)
  FILL(O.M31, 3, 1)
  FILL(O.M44, 4, 4)
  return O;
}

#--- pixel.hlsl
#include "common.hlsl"

struct PSInput {
  float4 Pos : SV_Position;
  nointerpolation float3x2 M32 : MATA;
  nointerpolation float2x4 M24 : MATB;
  nointerpolation float3x1 M31 : MATC;
  nointerpolation float4x4 M44 : MATD;
};

#define CHECK(M, V, Rows, Cols)                                                \
  [unroll] for (uint R = 0; R < Rows; ++R)                                     \
    [unroll] for (uint C = 0; C < Cols; ++C)                                   \
      Pass = Pass && M[R][C] == FM(V, R, C);

float4 main(PSInput I) : SV_Target {
  bool Pass = true;
  float3x2 M32V0 = GetAttributeAtVertex(I.M32, 0);
  CHECK(M32V0, 0, 3, 2)
  float3x2 M32V1 = GetAttributeAtVertex(I.M32, 1);
  CHECK(M32V1, 1, 3, 2)
  float3x2 M32V2 = GetAttributeAtVertex(I.M32, 2);
  CHECK(M32V2, 2, 3, 2)
  float2x4 M24V0 = GetAttributeAtVertex(I.M24, 0);
  CHECK(M24V0, 0, 2, 4)
  float2x4 M24V1 = GetAttributeAtVertex(I.M24, 1);
  CHECK(M24V1, 1, 2, 4)
  float2x4 M24V2 = GetAttributeAtVertex(I.M24, 2);
  CHECK(M24V2, 2, 2, 4)
  float3x1 M31V0 = GetAttributeAtVertex(I.M31, 0);
  CHECK(M31V0, 0, 3, 1)
  float3x1 M31V1 = GetAttributeAtVertex(I.M31, 1);
  CHECK(M31V1, 1, 3, 1)
  float3x1 M31V2 = GetAttributeAtVertex(I.M31, 2);
  CHECK(M31V2, 2, 3, 1)
  float4x4 M44V0 = GetAttributeAtVertex(I.M44, 0);
  CHECK(M44V0, 0, 4, 4)
  float4x4 M44V1 = GetAttributeAtVertex(I.M44, 1);
  CHECK(M44V1, 1, 4, 4)
  float4x4 M44V2 = GetAttributeAtVertex(I.M44, 2);
  CHECK(M44V2, 2, 4, 4)
  return (float4)Pass;
}

#--- pipeline.yaml
---
Shaders:
  - Stage: Vertex
    Entry: main
  - Stage: Pixel
    Entry: main
Buffers:
  # One triangle that covers the whole render target.
  - Name: VertexData
    Format: Float32
    Stride: 8
    Data: [-1, -1, 3, -1, -1, 3]
  - Name: Output
    Format: Float32
    Channels: 4
    FillSize: 256
    OutputProps:
      Height: 4
      Width: 4
      Depth: 1
  - Name: ExpectedOut
    Format: Float32
    Channels: 4
    FillSize: 256
    FillValue: 1
Bindings:
  VertexBuffer: VertexData
  VertexAttributes:
    - Format: Float32
      Channels: 2
      Offset: 0
      Name: POSITION
  RenderTarget: Output
DescriptorSets: []
Results:
  - Result: AttributeAtVertex
    Rule: BufferExact
    Actual: Output
    Expected: ExpectedOut
...
#--- end

# GetAttributeAtVertex(Attr, Index) returns the uninterpolated value of a
# nointerpolation attribute at vertex Index of the triangle, in the order the
# vertices were submitted (the same order SV_Barycentrics uses). A single
# triangle covers the 4x4 render target and the vertex shader writes a
# different value per SV_VertexID, so each pixel can check all three vertices.

# Unlike the vector tests, this does not also read the matrices directly:
# DXC's SPIR-V backend emits invalid SPIR-V when a matrix is both read
# directly and passed to GetAttributeAtVertex.

# Covers rows > columns, columns > rows, a single column and the largest
# matrix. A constant-folded matrix is not applicable because the argument
# must be a pixel shader input.

# Unimplemented https://github.com/llvm/llvm-project/issues/99201
# XFAIL: Clang

# REQUIRES: SM_6_1 && Barycentrics

# RUN: split-file %s %t
# RUN: %dxc_target -T vs_6_0 -Fo %t-vertex.o %t/vertex.hlsl
# RUN: %dxc_target -T ps_6_1 -Fo %t-pixel.o %t/pixel.hlsl
# RUN: %offloader %t/pipeline.yaml %t-vertex.o %t-pixel.o
